{
  "name": "openclaw-now4real",
  "description": "Now4real live chat widget channel plugin for OpenClaw",
  "version": "0.2.1",
  "type": "module",
  "author": "Now4real <support@now4real.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/now4real/openclaw-now4real"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "now4real",
    "live-chat",
    "chat",
    "website-chat",
    "group-chat",
    "chat-box",
    "web-chat",
    "html-chat",
    "multiplayer-chat",
    "collaborative-chat",
    "embeddable-chat",
    "pagechat",
    "chat-widget",
    "chatbot"
  ],
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "now4real",
      "label": "Now4real",
      "blurb": "Connect OpenClaw to Now4real pagechat."
    },
    "compat": {
      "pluginApi": ">=2026.5.3",
      "minGatewayVersion": "2026.5.3"
    },
    "build": {
      "openclawVersion": "2026.5.3",
      "pluginSdkVersion": "2026.5.3"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "^2026.5.3",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.3"
  }
}
